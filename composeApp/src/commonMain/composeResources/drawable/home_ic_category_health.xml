<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn after docs/design/home-feed/assets/category-health-pills-partial.png (the original is cut off):
     two 20x44 capsules crossing at +-45deg, one with a divider line. Single colour, tinted in code;
     stroke 2.5 = ~2 dp at the 48 dp display size. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60dp"
    android:height="60dp"
    android:viewportWidth="60"
    android:viewportHeight="60">
    <group
        android:pivotX="30"
        android:pivotY="30"
        android:rotation="-45">
        <path
            android:pathData="M20,18A10,10 0,0 1,40 18V42A10,10 0,0 1,20 42Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <group
        android:pivotX="30"
        android:pivotY="30"
        android:rotation="45">
        <path
            android:pathData="M20,18A10,10 0,0 1,40 18V42A10,10 0,0 1,20 42ZM20,30H40"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
